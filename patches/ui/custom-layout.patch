--- a/browser/themes/shared/browser.css
+++ b/browser/themes/shared/browser.css
@@ -1025,6 +1025,124 @@
   color: var(--lwt-tab-text);
 }

+/* BOBZILLA: Floorp/Zen inspired minimal dynamic UI styling */
+:root[bobzilla-vertical-tabs="true"] #TabsToolbar {
+  /* Hide standard horizontal tab bar only when vertical tabs are active */
+  display: none !important;
+}
+
+:root[bobzilla-vertical-tabs="true"] .bobzilla-vertical-tabs {
+  display: flex !important;
+  flex-direction: column !important;
+  width: 240px !important;
+  min-width: 48px !important;
+  max-width: 320px !important;
+  will-change: width, box-shadow !important;
+  transition: width 0.22s cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 0.22s ease !important;
+  background-color: var(--toolbar-bgcolor, #1c1b22) !important;
+  border-right: 1px solid var(--chrome-content-separator-color, rgba(255, 255, 255, 0.1)) !important;
+  z-index: 100 !important;
+}
+
+/* Responsive viewport adjustments for split-screen and tiled window managers (< 960px) */
+:root[bobzilla-vertical-tabs="true"][bobzilla-compact-viewport="true"] .bobzilla-vertical-tabs {
+  width: 180px !important;
+  font-size: 0.92em !important;
+}
+
+/* Collapsed icon-only mode with smooth auto-expand on hover */
+:root[bobzilla-sidebar-collapsed="true"] .bobzilla-vertical-tabs {
+  width: 48px !important;
+  overflow: hidden !important;
+}
+
+:root[bobzilla-sidebar-collapsed="true"] .bobzilla-vertical-tabs .tab-label {
+  opacity: 0 !important;
+  transition: opacity 0.15s ease !important;
+}
+
+:root[bobzilla-sidebar-collapsed="true"] .bobzilla-vertical-tabs:hover {
+  width: 240px !important;
+  box-shadow: 4px 0 16px rgba(0, 0, 0, 0.35) !important;
+}
+
+:root[bobzilla-sidebar-collapsed="true"] .bobzilla-vertical-tabs:hover .tab-label {
+  opacity: 1 !important;
+  transition: opacity 0.2s ease 0.08s !important;
+}
+
+/* Pinned tabs horizontal grid arrangement in vertical mode to save vertical screen space */
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab[pinned] {
+  display: inline-flex !important;
+  width: 38px !important;
+  min-width: 38px !important;
+  max-width: 38px !important;
+  height: 34px !important;
+  min-height: 34px !important;
+  margin: 2px !important;
+  justify-content: center !important;
+  align-items: center !important;
+}
+
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab[pinned] .tab-label-container,
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab[pinned] .tab-close-button {
+  display: none !important;
+}
+
+/* Tab styling ergonomics and hover feedback */
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab {
+  border-radius: 4px !important;
+  margin: 1px 4px !important;
+  transition: background-color 0.12s ease, transform 0.1s ease !important;
+}
+
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab:hover {
+  background-color: var(--tab-hover-bgcolor, rgba(255, 255, 255, 0.05)) !important;
+}
+
+/* Drag-and-drop reordering drop target cues */
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab[dragover="true"] {
+  border-top: 2px solid var(--tab-selected-accent, #3584e4) !important;
+}
+
+/* Active tab indicator and accent bar */
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab[selected="true"] {
+  background-color: var(--tab-selected-bgcolor, rgba(255, 255, 255, 0.08)) !important;
+  border-left: 3px solid var(--tab-selected-accent, #3584e4) !important;
+  font-weight: 600 !important;
+}
+
+/* Smooth close button visibility on tab hover */
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab .tab-close-button {
+  opacity: 0.6 !important;
+  border-radius: 3px !important;
+  transition: opacity 0.12s ease, background-color 0.12s ease !important;
+}
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab .tab-close-button:hover {
+  opacity: 1 !important;
+  background-color: rgba(255, 255, 255, 0.15) !important;
+}
+:root[bobzilla-vertical-tabs="true"] .tabbrowser-tab:hover .tab-close-button {
+  opacity: 0.8 !important;
+}
+
+/* Compact density styling for vertical tabs when browser.uidensity == 1 */
+:root[bobzilla-compact-ui="true"] .bobzilla-vertical-tabs .tabbrowser-tab {
+  min-height: 28px !important;
+  height: 28px !important;
+  padding-top: 1px !important;
+  padding-bottom: 1px !important;
+  font-size: 0.9em !important;
+}
+
+:root[bobzilla-compact-ui="true"] #nav-bar {
+  /* Slimmer navigation bar for maximum screen real estate */
+  padding-top: 2px !important;
+  padding-bottom: 2px !important;
+  min-height: 32px !important;
+}
+
 .tabbrowser-tab {
   min-height: var(--tab-min-height);
 }
