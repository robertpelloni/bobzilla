--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -279,6 +279,14 @@
 // Whether Firefox will show the Compact Mode UIDensity option.
-pref("browser.compactmode.show", false);
+pref("browser.compactmode.show", true);
+
+// BOBZILLA: Dynamic Density & Custom UI Scaling Defaults
+// Enable compact density (1 = Compact, 0 = Normal, 2 = Touch) by default
+pref("browser.uidensity", 1);
+
+// Fix base display scaling factor
+pref("layout.css.devPixelsPerPx", "1.0");
+
+// Allow sub-pixel antialiasing and text density optimization
+pref("gfx.text.subpixel-position.force-enabled", true);

 // At startup, check if we're the default browser and prompt user if not.
 pref("browser.shell.checkDefaultBrowser", true);
