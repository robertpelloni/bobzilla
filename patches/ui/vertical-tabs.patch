--- a/browser/components/tabbrowser/content/tabbrowser.js
+++ b/browser/components/tabbrowser/content/tabbrowser.js
@@ -102,6 +102,96 @@
     // Standard horizontal layout
     this.tabContainer.setAttribute("orient", "horizontal");
   }
+
+  // BOBZILLA: Dynamic Vertical Tabs with browser.uidensity & Responsive Resize Integration
+  initVerticalTabs() {
+    const verticalPref = "sidebar.verticalTabs";
+    const densityPref = "browser.uidensity";
+    const collapsedPref = "sidebar.verticalTabs.collapsed";
+
+    const applyLayout = () => {
+      let isVertical = Services.prefs.getBoolPref(verticalPref, true);
+      let density = Services.prefs.getIntPref(densityPref, 1); // 1 = Compact default
+      let isCollapsed = Services.prefs.getBoolPref(collapsedPref, false);
+
+      if (isVertical) {
+        this.tabContainer.setAttribute("orient", "vertical");
+        this.tabContainer.classList.add("bobzilla-vertical-tabs");
+        document.documentElement.setAttribute("bobzilla-vertical-tabs", "true");
+
+        if (isCollapsed) {
+          document.documentElement.setAttribute("bobzilla-sidebar-collapsed", "true");
+        } else {
+          document.documentElement.removeAttribute("bobzilla-sidebar-collapsed");
+        }
+
+        // Handle compact vs normal vs touch density for vertical tab list
+        if (density === 1) {
+          this.tabContainer.classList.add("bobzilla-compact-tabs");
+          this.tabContainer.setAttribute("density", "compact");
+          document.documentElement.setAttribute("bobzilla-compact-ui", "true");
+        } else if (density === 2) {
+          this.tabContainer.classList.remove("bobzilla-compact-tabs");
+          this.tabContainer.setAttribute("density", "touch");
+          document.documentElement.removeAttribute("bobzilla-compact-ui");
+        } else {
+          this.tabContainer.classList.remove("bobzilla-compact-tabs");
+          this.tabContainer.setAttribute("density", "normal");
+          document.documentElement.removeAttribute("bobzilla-compact-ui");
+        }
+      } else {
+        this.tabContainer.setAttribute("orient", "horizontal");
+        this.tabContainer.classList.remove("bobzilla-vertical-tabs", "bobzilla-compact-tabs");
+        document.documentElement.removeAttribute("bobzilla-vertical-tabs");
+        document.documentElement.removeAttribute("bobzilla-sidebar-collapsed");
+      }
+    };
+
+    // Dynamic responsive width listener for split-screen / tiled window ergonomics
+    const handleResize = () => {
+      if (window.innerWidth < 960) {
+        document.documentElement.setAttribute("bobzilla-compact-viewport", "true");
+      } else {
+        document.documentElement.removeAttribute("bobzilla-compact-viewport");
+      }
+    };
+
+    // Toggle collapsed sidebar state helper
+    this.toggleVerticalTabsCollapsed = () => {
+      let current = Services.prefs.getBoolPref(collapsedPref, false);
+      Services.prefs.setBoolPref(collapsedPref, !current);
+    };
+
+    // Create new tab helper inside vertical tab strip
+    this.createNewVerticalTab = () => {
+      this.addTab("about:blank", { triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal() });
+    };
+
+    // Keyboard shortcut handler: Accel+Alt+V toggles vertical tab mode
+    const handleKeyDown = (e) => {
+      if ((e.ctrlKey || e.metaKey) && e.altKey && (e.key === "v" || e.key === "V")) {
+        let current = Services.prefs.getBoolPref(verticalPref, true);
+        Services.prefs.setBoolPref(verticalPref, !current);
+        e.preventDefault();
+      }
+    };
+
+    window.addEventListener("keydown", handleKeyDown, { capture: true });
+    window.addEventListener("resize", handleResize, { passive: true });
+    handleResize();
+    Services.prefs.addObserver(verticalPref, applyLayout);
+    Services.prefs.addObserver(densityPref, applyLayout);
+    Services.prefs.addObserver(collapsedPref, applyLayout);
+    applyLayout();
+  }
 }
