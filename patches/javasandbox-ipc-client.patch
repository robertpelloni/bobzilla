--- a/netwerk/base/nsProcessBroker.cpp
+++ b/netwerk/base/nsProcessBroker.cpp
@@ -200,6 +200,43 @@

 nsresult nsProcessBroker::LaunchMicroVM(const char* aPayloadSpec) {
+  // BOBZILLA: Javasandbox IPC Client Integration
+  // Connects to the external Rust `runner-daemon` using multi-path resolution
+  // (checking BOBZILLA_SOCKET, XDG_RUNTIME_DIR, /run/user/$UID, and /tmp fallbacks)
+  // to transmit the parsed javasandbox:// URI payload for Firecracker execution.
+
+  const char* socket_paths[] = {
+    getenv("BOBZILLA_SOCKET"),
+    "/run/user/1001/bobzilla-sandbox.sock",
+    "/run/user/1000/bobzilla-sandbox.sock",
+    "/tmp/bobzilla-sandbox-1001.sock",
+    "/tmp/bobzilla-sandbox-1000.sock",
+    "/tmp/bobzilla-sandbox.sock"
+  };
+
+  int sock = -1;
+  for (size_t i = 0; i < sizeof(socket_paths)/sizeof(socket_paths[0]); ++i) {
+    const char* path = socket_paths[i];
+    if (!path || access(path, F_OK) != 0) continue;
+
+    sock = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (sock < 0) continue;
+
+    struct sockaddr_un server_addr;
+    memset(&server_addr, 0, sizeof(server_addr));
+    server_addr.sun_family = AF_UNIX;
+    strncpy(server_addr.sun_path, path, sizeof(server_addr.sun_path) - 1);
+
+    if (connect(sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) == 0) {
+      break; // Successfully connected!
+    }
+    close(sock);
+    sock = -1;
+  }
+
+  if (sock < 0) {
+    return NS_ERROR_CONNECTION_REFUSED;
+  }
+
+  // Send the payload string to the daemon prefixed with LAUNCH
+  char msg_buf[1024];
+  snprintf(msg_buf, sizeof(msg_buf), "LAUNCH %s\n", aPayloadSpec);
+  send(sock, msg_buf, strlen(msg_buf), 0);
+  close(sock);
+
   return NS_OK;
 }
